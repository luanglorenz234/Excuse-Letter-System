rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isHR() {
      return isSignedIn() && getUserData().role == 'hr' && getUserData().status == 'active';
    }

    function isActiveIntern() {
      return isSignedIn() && getUserData().role == 'intern' && getUserData().status == 'active';
    }

    // 1. users/{uid}
    // Intern reads own doc and updates only name & savedSignature.
    // HR reads all and updates profile fields + status. Nobody changes their own role.
    match /users/{uid} {
      allow read: if isOwner(uid) || isHR();
      allow create: if isOwner(uid)
                    && request.resource.data.role == 'intern'
                    && request.resource.data.status == 'pending';
      allow update: if (isOwner(uid)
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'savedSignature', 'updatedAt']))
                    || (isHR()
                        && (!isOwner(uid) || request.resource.data.role == resource.data.role));
    }

    // 2. requests/{id}
    // Intern: create own; read own; update own only while draft or returned, or submitted -> withdrawn.
    // HR: read all; update only status, review, history, refNo, updatedAt.
    match /requests/{requestId} {
      allow read: if isHR() || (isSignedIn() && resource.data.uid == request.auth.uid);

      allow create: if isActiveIntern()
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.status in ['draft', 'submitted']
                    && request.resource.data.refNo == null;

      allow update: if (
        // Intern updating own draft or returned request
        (isActiveIntern()
         && resource.data.uid == request.auth.uid
         && resource.data.status in ['draft', 'returned']
         && request.resource.data.status in ['draft', 'submitted']
         && request.resource.data.refNo == resource.data.refNo)
        ||
        // Intern withdrawing a submitted request
        (isActiveIntern()
         && resource.data.uid == request.auth.uid
         && resource.data.status == 'submitted'
         && request.resource.data.status == 'withdrawn'
         && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'history', 'updatedAt']))
        ||
        // HR reviewing request (Approve / Return / Decline)
        (isHR()
         && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'review', 'history', 'refNo', 'updatedAt']))
      );
    }

    // 3. absenceSlots/{slotId}
    // Duplicate guard: {uid}_{yyyy-mm-dd}_{am|pm}
    match /absenceSlots/{slotId} {
      allow read: if isSignedIn();
      allow create: if isActiveIntern()
                    && request.resource.data.uid == request.auth.uid;
      allow delete: if (isSignedIn() && resource.data.uid == request.auth.uid) || isHR();
    }

    // 4. counters/{year}
    // Reference number counter (HR only)
    match /counters/{year} {
      allow read, write: if isHR();
    }

    // 5. settings/letter
    // Locked letter template settings: any signed-in user reads; HR writes
    match /settings/letter {
      allow read: if isSignedIn();
      allow write: if isHR();
    }
  }
}
